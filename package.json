{
  "name": "claude-in-firefox",
  "version": "0.1.1",
  "description": "Firefox WebExtension + MCP server that gives Claude Code the same browser tools as Claude in Chrome",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "vitest run",
    "e2e": "vitest run --config e2e/vitest.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "firefox": "web-ext run --source-dir dist/extension --keep-profile-changes --firefox-profile default-release",
    "sign": "web-ext sign --source-dir dist/extension --channel unlisted --artifacts-dir web-ext-artifacts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  }
}
