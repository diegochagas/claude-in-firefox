#!/usr/bin/env bash
# scripts/check: the single gate (pre-push hook + CI). Fast first, slow last.
set -euo pipefail
cd "$(dirname "$0")/.."
npx prettier --check . >/dev/null || { echo "prettier: run 'npm run format'"; npx prettier --check .; exit 1; }
npx tsc --noEmit
npx eslint .
npx vitest run
npm run build --silent
scripts/clean-code-audit --strict --max-file-lines 300
