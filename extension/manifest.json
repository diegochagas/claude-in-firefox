{
  "manifest_version": 2,
  "name": "Claude in Firefox",
  "version": "0.1.0",
  "description": "Lets Claude Code drive this Firefox: tabs, clicks, typing, screenshots, page reading, console and network logs.",
  "homepage_url": "https://github.com/diegochagas/claude-in-firefox",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-in-firefox@diegochagas.dev",
      "strict_min_version": "128.0",
      "update_url": "https://github.com/diegochagas/claude-in-firefox/releases/latest/download/updates.json"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "match_about_blank": true
    }
  ],
  "browser_action": {
    "default_icon": {
      "48": "icons/icon-48.png"
    },
    "default_title": "Claude in Firefox: not connected"
  }
}
